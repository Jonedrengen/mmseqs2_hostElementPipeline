#this is a config to run the host element pipeline analysis
#see README.md for more information

#must set
source_directory=path/to/mmseqs2_hostElementPipeline/host_element_pipeline_v2
conda_env_prefix=path/to/opt/anaconda3/envs/mmseqs2_JOSS

#mode (local, slurm)
mode=

#can be optionally set
reference_gene_list_name=elementgeneList.fasta

#mmseqs settings (do not touch, unless you know what you are doing)
cov_modes_array=1 2
max_seq_lengths_array=10000 35283 65535