#this is a config to run the host element pipeline analysis
#see README.md for more information

#must set
source_directory=path/to/mmseqs2_hostElementPipeline/host_element_pipeline_v2
conda_env_prefix=path/to/opt/anaconda3/envs/mmseqs2_HEP

#screening database: leave blank to use source_directory/database/elementgeneList.fasta
reference_fasta_file=

#execution mode (local, slurm)
execution_mode=slurm

#input discovery
fasta_pattern=*.f*

#mmseqs settings
#base host options: Human, Beef, Chicken or Pork - header: Genome_Ref\tHost
base_host=Human
mmseqs_min_seq_id=0.8
mmseqs_coverage=0.8
mmseqs_sensitivity=7.5
mmseqs_max_seqs=1000

#do not touch, unless you know what you are doing
cov_modes_array=1 2
max_seq_lengths_array=10000 35283 65535

#slurm settings ()
slurm_cpus_per_job=1
slurm_memory_per_job=16G
slurm_partition=project
max_jobs_per_array=1000
max_parallel_jobs_per_array=12